{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "4D-VR-THEATRE/1 control protocol 1.0.0",
  "protocol": "4D-VR-THEATRE/1",
  "version": "1.0.0",
  "envelope": {
    "$defs": {
      "MsgType": {
        "enum": [
          "REGISTER",
          "AUTHENTICATE",
          "HEARTBEAT",
          "TIME_SYNC",
          "MANIFEST",
          "PREPARE",
          "READY",
          "PLAY",
          "PAUSE",
          "RESUME",
          "STOP",
          "RESTART",
          "SYNC",
          "BLACK_SCREEN",
          "STATUS",
          "ERROR"
        ],
        "title": "MsgType",
        "type": "string"
      }
    },
    "properties": {
      "protocol": {
        "title": "Protocol",
        "type": "string"
      },
      "type": {
        "$ref": "#/$defs/MsgType"
      },
      "id": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "ts": {
        "title": "Ts",
        "type": "number"
      },
      "request_id": {
        "anyOf": [
          {
            "maxLength": 64,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Request Id"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      }
    },
    "required": [
      "protocol",
      "type",
      "id",
      "ts"
    ],
    "title": "Envelope",
    "type": "object"
  },
  "client_to_server": {
