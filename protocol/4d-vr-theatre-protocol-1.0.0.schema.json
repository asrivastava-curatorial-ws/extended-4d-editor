      },
      "properties": {
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        },
        "device_type": {
          "$ref": "#/$defs/DeviceType"
        },
        "app_version": {
          "maxLength": 32,
          "title": "App Version",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 16,
          "title": "Protocol Version",
          "type": "string"
        },
        "capabilities": {
          "additionalProperties": true,
          "title": "Capabilities",
          "type": "object"
        },
        "hardware": {
          "additionalProperties": true,
          "title": "Hardware",
          "type": "object"
