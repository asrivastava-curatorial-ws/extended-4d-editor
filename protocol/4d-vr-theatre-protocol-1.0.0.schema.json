        "device_id",
        "device_type",
        "app_version",
        "protocol_version"
      ],
      "title": "RegisterPayload",
      "type": "object"
    },
    "AUTHENTICATE": {
      "properties": {
        "stage": {
          "const": "response",
          "default": "response",
          "title": "Stage",
          "type": "string"
        },
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        },
        "nonce": {
          "maxLength": 128,
          "minLength": 16,
          "title": "Nonce",
          "type": "string"
        },
        "mac": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mac",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "nonce",
        "mac"
      ],
      "title": "AuthResponse",
      "type": "object"
    },
    "HEARTBEAT": {
      "properties": {
        "state": {
          "default": "UNKNOWN",
